<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ActionCut "AC Ligature": a bold C cradling a play triangle (the A). -->

    <!-- The C: a thick round-capped arc open on the right, in the red -> gold brand gradient -->
    <path
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M72.76,73.42 A27,27 0 0 1 27,54 A27,27 0 0 1 72.76,34.58">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="27" android:startY="27" android:endX="87" android:endY="87">
                <item android:offset="0" android:color="#FFFF2E4D" />
                <item android:offset="0.5" android:color="#FFFF6B3D" />
                <item android:offset="1" android:color="#FFFFC247" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The play triangle (the "A" / play mark) nested in the C's opening -->
    <path android:pathData="M45,40 L69,54 L45,68 Q45,68.6 44,68 L44,40 Q45,39.4 45,40 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="44" android:startY="40" android:endX="69" android:endY="68">
                <item android:offset="0" android:color="#FFFF2E4D" />
                <item android:offset="0.5" android:color="#FFFF6B3D" />
                <item android:offset="1" android:color="#FFFFC247" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

